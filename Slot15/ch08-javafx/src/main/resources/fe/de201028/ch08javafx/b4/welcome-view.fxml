      alignment="CENTER" spacing="16" prefWidth="400" prefHeight="250">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
    <Label text="CHÀO MỪNG" style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #188038;"/>
